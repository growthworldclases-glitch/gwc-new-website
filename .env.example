# HostyCare cPanel Node.js App -> Environment Variables
# Use the EXISTING deployed Google Apps Script /exec URL as a private value.
GWC_API_URL=https://script.google.com/macros/s/PASTE_EXISTING_DEPLOYMENT_ID/exec
# Generate a random secret of at least 32 characters and set the SAME value
# in Apps Script Project Settings -> Script Properties -> GWC_API_SECRET.
GWC_API_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
